# Unanet Platform REST Configuration
# Use the origin only; do not include /platform/rest or embedded credentials.
UNANET_BASE_URL=https://navapbc.unanet.biz
UNANET_USERNAME=your-username
# If the password contains #, or starts or ends with a space, wrap it in single
# quotes, for example UNANET_PASSWORD='p#ss word' (backticks if it also contains
# a single quote). Unquoted, the value is cut off at the # or trimmed.
UNANET_PASSWORD=your-password

# Optional: value sent in the X-Una-App header.
UNANET_APP_NAME=NavaUnanetMCP

# Optional: expose org-level read tools (projects, people, organizations,
# contracts, invoices, reference data) plus the generic spec-driven API
# catalog/reader (unanet_api_search_operations / unanet_api_read).
# UNANET_ENABLE_LEGACY_READ_TOOLS (the old name) is no longer supported.
UNANET_ENABLE_EXTENDED_READ_TOOLS=false

# Optional: expose mutating tools (timesheet/expense/leave writes, approvals,
# reviews, My Projects, attachments). Every write requires confirm: true. Keep
# disabled unless you explicitly want write-capable tools available in your
# Claude app.
UNANET_ENABLE_WRITE_TOOLS=false

# Optional: tenant id sent as customerId in the login request. Leave unset for
# the Nava tenant (it logs in without one). Set it only if your Unanet tenant
# rejects the login without a customer id.
# UNANET_CUSTOMER_ID=

# Optional: comma-separated allow-list for additional production Unanet origins.
# UNANET_ALLOWED_BASE_URLS=https://example.unanet.biz

# Optional: local mock testing only. Never enable for production URLs.
UNANET_ALLOW_INSECURE_LOCAL_MOCK=false

# Optional: logging level.
LOG_LEVEL=info
